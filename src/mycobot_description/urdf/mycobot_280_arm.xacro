<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Cánh tay myCobot 280 (6 DOF). Cấu trúc link/joint + offset lấy nguyên từ
    URDF thật của Elephant Robotics; đã thêm:
      - <inertial> cho mọi link (Gazebo bắt buộc)
      - velocity limit dương (gốc = 0, sẽ khiến controller/MoveIt lỗi)
    Mesh chuyển sang package://mycobot_description/meshes/...
  -->
  <xacro:property name="mesh" value="package://mycobot_description/meshes/mycobot_280_arduino"/>
  <xacro:property name="vel" value="3.14"/>
  <xacro:property name="eff" value="50.0"/>

  <!-- ================= LINKS ================= -->
  <link name="g_base">
    <visual>
      <geometry><mesh filename="${mesh}/G_base.dae"/></geometry>
      <origin xyz="-0.01 0 -0.032" rpy="0 0 1.5708"/>
    </visual>
    <collision>
      <geometry><box size="0.09 0.09 0.06"/></geometry>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.5" size="0.05"/>
  </link>

  <link name="joint1">
    <visual>
      <geometry><mesh filename="${mesh}/joint1.dae"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 -3.14159"/>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.09"/></geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.3" size="0.04"/>
  </link>

  <link name="joint2">
    <visual>
      <geometry><mesh filename="${mesh}/joint2.dae"/></geometry>
      <origin xyz="0 0 -0.06096" rpy="0 0 -1.5708"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.06 0.08"/></geometry>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.3" size="0.04"/>
  </link>

  <link name="joint3">
    <visual>
      <geometry><mesh filename="${mesh}/joint3.dae"/></geometry>
      <origin xyz="0 0 0.03256" rpy="0 -1.5708 0"/>
    </visual>
    <collision>
      <geometry><box size="0.09 0.06 0.06"/></geometry>
      <origin xyz="-0.05 0 0.03" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.25" size="0.04"/>
  </link>

  <link name="joint4">
    <visual>
      <geometry><mesh filename="${mesh}/joint4.dae"/></geometry>
      <origin xyz="0 0 0.03056" rpy="0 -1.5708 0"/>
    </visual>
    <collision>
      <geometry><box size="0.08 0.06 0.06"/></geometry>
      <origin xyz="-0.04 0 0.03" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.2" size="0.035"/>
  </link>

  <link name="joint5">
    <visual>
      <geometry><mesh filename="${mesh}/joint5.dae"/></geometry>
      <origin xyz="0 0 -0.03356" rpy="-1.5708 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.06 0.05"/></geometry>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.2" size="0.035"/>
  </link>

  <link name="joint6">
    <visual>
      <geometry><mesh filename="${mesh}/joint6.dae"/></geometry>
      <origin xyz="0 0 -0.038" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.045 0.045 0.03"/></geometry>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.15" size="0.03"/>
  </link>

  <link name="joint6_flange">
    <visual>
      <geometry><mesh filename="${mesh}/joint7.dae"/></geometry>
      <origin xyz="0 0 -0.012" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 0.02"/></geometry>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.1" size="0.02"/>
  </link>

  <!-- ================= JOINTS ================= -->
  <joint name="g_base_to_joint1" type="fixed">
    <parent link="g_base"/>
    <child link="joint1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${eff}" lower="-2.9321" upper="2.9321" velocity="${vel}"/>
    <parent link="joint1"/>
    <child link="joint2"/>
    <origin xyz="0 0 0.13156" rpy="0 0 0"/>
  </joint>

  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${eff}" lower="-2.4434" upper="2.4434" velocity="${vel}"/>
    <parent link="joint2"/>
    <child link="joint3"/>
    <origin xyz="0 0 0" rpy="0 1.5708 -1.5708"/>
  </joint>

  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${eff}" lower="-2.6179" upper="2.6179" velocity="${vel}"/>
    <parent link="joint3"/>
    <child link="joint4"/>
    <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${eff}" lower="-2.6179" upper="2.6179" velocity="${vel}"/>
    <parent link="joint4"/>
    <child link="joint5"/>
    <origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${eff}" lower="-2.7052" upper="2.7925" velocity="${vel}"/>
    <parent link="joint5"/>
    <child link="joint6"/>
    <origin xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0"/>
  </joint>

  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${eff}" lower="-3.14" upper="3.14159" velocity="${vel}"/>
    <parent link="joint6"/>
    <child link="joint6_flange"/>
    <origin xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
  </joint>
</robot>
