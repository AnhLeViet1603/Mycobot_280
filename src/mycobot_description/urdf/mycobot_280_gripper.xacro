<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Gripper thích ứng (adaptive) của myCobot 280.
    Chỉ 1 khớp thật `gripper_controller` được điều khiển; 5 khớp còn lại `mimic`
    theo nó (đóng/mở đồng bộ) - đã có sẵn trong URDF gốc của Elephant Robotics.
    Đã thêm inertial + velocity limit dương. Thêm frame `grasp_center` làm điểm
    gắp (attach vật + MoveIt end-effector).
  -->
  <xacro:property name="gmesh" value="package://mycobot_description/meshes/adaptive_gripper"/>
  <xacro:property name="gvel" value="2.0"/>
  <xacro:property name="geff" value="20.0"/>

  <!-- Nối gripper vào flange của cánh tay -->
  <joint name="joint6output_to_gripper_base" type="fixed">
    <parent link="joint6_flange"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.034" rpy="1.579 0 0"/>
  </joint>

  <link name="gripper_base">
    <visual>
      <geometry><mesh filename="${gmesh}/gripper_base.dae"/></geometry>
      <origin xyz="0 0 -0.012" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><mesh filename="${gmesh}/gripper_base.dae"/></geometry>
      <origin xyz="0 0 -0.012" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.1" size="0.03"/>
  </link>

  <link name="gripper_left1">
    <visual><geometry><mesh filename="${gmesh}/gripper_left1.dae"/></geometry>
      <origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/></visual>
    <collision><geometry><mesh filename="${gmesh}/gripper_left1.dae"/></geometry>
      <origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/></collision>
    <xacro:box_inertial mass="0.02" size="0.015"/>
  </link>

  <link name="gripper_left2">
    <visual><geometry><mesh filename="${gmesh}/gripper_left2.dae"/></geometry>
      <origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/></visual>
    <collision><geometry><mesh filename="${gmesh}/gripper_left2.dae"/></geometry>
      <origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/></collision>
    <xacro:box_inertial mass="0.02" size="0.015"/>
  </link>

  <link name="gripper_left3">
    <visual><geometry><mesh filename="${gmesh}/gripper_left3.dae"/></geometry>
      <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/></visual>
    <collision><geometry><mesh filename="${gmesh}/gripper_left3.dae"/></geometry>
      <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/></collision>
    <xacro:box_inertial mass="0.02" size="0.015"/>
  </link>

  <link name="gripper_right1">
    <visual><geometry><mesh filename="${gmesh}/gripper_right1.dae"/></geometry>
      <origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/></visual>
    <collision><geometry><mesh filename="${gmesh}/gripper_right1.dae"/></geometry>
      <origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/></collision>
    <xacro:box_inertial mass="0.02" size="0.015"/>
  </link>

  <link name="gripper_right2">
    <visual><geometry><mesh filename="${gmesh}/gripper_right2.dae"/></geometry>
      <origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/></visual>
    <collision><geometry><mesh filename="${gmesh}/gripper_right2.dae"/></geometry>
      <origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/></collision>
    <xacro:box_inertial mass="0.02" size="0.015"/>
  </link>

  <link name="gripper_right3">
    <visual><geometry><mesh filename="${gmesh}/gripper_right3.dae"/></geometry>
      <origin xyz="-0.012 0.0025 -0.012" rpy="0 0 0"/></visual>
    <collision><geometry><mesh filename="${gmesh}/gripper_right3.dae"/></geometry>
      <origin xyz="-0.012 0.0025 -0.012" rpy="0 0 0"/></collision>
    <xacro:box_inertial mass="0.02" size="0.015"/>
  </link>

  <!-- Khớp điều khiển chính -->
  <joint name="gripper_controller" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${geff}" lower="-0.74" upper="0.15" velocity="${gvel}"/>
    <parent link="gripper_base"/>
    <child link="gripper_left3"/>
    <origin xyz="-0.012 0.005 0" rpy="0 0 0"/>
  </joint>

  <joint name="gripper_base_to_gripper_left2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${geff}" lower="-0.8" upper="0.5" velocity="${gvel}"/>
    <parent link="gripper_base"/>
    <child link="gripper_left2"/>
    <origin xyz="-0.005 0.027 0" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="1.0" offset="0"/>
  </joint>

  <joint name="gripper_left3_to_gripper_left1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${geff}" lower="-0.5" upper="0.5" velocity="${gvel}"/>
    <parent link="gripper_left3"/>
    <child link="gripper_left1"/>
    <origin xyz="-0.027 0.016 0" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
  </joint>

  <joint name="gripper_base_to_gripper_right3" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${geff}" lower="-0.15" upper="0.7" velocity="${gvel}"/>
    <parent link="gripper_base"/>
    <child link="gripper_right3"/>
    <origin xyz="0.012 0.005 0" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
  </joint>

  <joint name="gripper_base_to_gripper_right2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${geff}" lower="-0.5" upper="0.8" velocity="${gvel}"/>
    <parent link="gripper_base"/>
    <child link="gripper_right2"/>
    <origin xyz="0.005 0.027 0" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="-1.0" offset="0"/>
  </joint>

  <joint name="gripper_right3_to_gripper_right1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${geff}" lower="-0.5" upper="0.5" velocity="${gvel}"/>
    <parent link="gripper_right3"/>
    <child link="gripper_right1"/>
    <origin xyz="0.027 0.016 0" rpy="0 0 0"/>
    <mimic joint="gripper_controller" multiplier="1.0" offset="0"/>
  </joint>

  <!-- Điểm gắp: nằm giữa 2 ngón, dùng cho attach vật + MoveIt EE.
       Offset tạm; sẽ tinh chỉnh khi xem trong RViz/Gazebo (Phase 6/7). -->
  <link name="grasp_center"/>
  <joint name="gripper_base_to_grasp_center" type="fixed">
    <parent link="gripper_base"/>
    <child link="grasp_center"/>
    <origin xyz="0 0.05 -0.012" rpy="0 0 0"/>
  </joint>
</robot>
