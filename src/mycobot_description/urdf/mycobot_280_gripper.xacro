<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Gripper myCobot 280 (bản đơn giản hoá cho Gazebo).
    - Hai khớp gốc ngón được ĐIỀU KHIỂN đối xứng:
        gripper_finger_joint  (ngón trái, gripper_left3)   : đóng khi ÂM
        gripper_right_joint   (ngón phải, gripper_right3)  : đóng khi DƯƠNG (đối xứng)
    - Bốn khớp linkage còn lại (left1/left2/right1/right2) HÀN CỐ ĐỊNH ở pose 0.
      => KHÔNG dùng <mimic> nữa: tránh lỗi "physics does not support mimic constraints"
         và tránh các khớp tự do bị xoay lung tung khi cánh tay chuyển động.
    - Collision là box primitive (nhẹ physics). grasp_center = điểm gắp (attach + MoveIt EE).
  -->
  <xacro:property name="gmesh" value="package://mycobot_description/meshes/adaptive_gripper"/>
  <xacro:property name="gvel" value="2.0"/>
  <xacro:property name="geff" value="20.0"/>

  <!-- Ngón KHÔNG có collision: tránh 2 ngón tự va/kẹt cứng làm kẹt controller.
       Việc gắp vật xử lý bằng attach/detach nên ngón không cần collision vật lý. -->
  <xacro:macro name="finger_link" params="name mesh_file ox oy oz">
    <link name="${name}">
      <visual>
        <geometry><mesh filename="${gmesh}/${mesh_file}"/></geometry>
        <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      </visual>
      <xacro:box_inertial mass="0.02" size="0.015"/>
    </link>
  </xacro:macro>

  <!-- Nối gripper vào flange của cánh tay -->
  <joint name="joint6output_to_gripper_base" type="fixed">
    <parent link="joint6_flange"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.034" rpy="1.579 0 0"/>
  </joint>

  <link name="gripper_base">
    <visual>
      <geometry><mesh filename="${gmesh}/gripper_base.dae"/></geometry>
      <origin xyz="0 0 -0.012" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.03 0.03"/></geometry>
      <origin xyz="0 0 -0.012" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="0.1" size="0.03"/>
  </link>

  <!-- left2/right2 (tấm bản giữa của cơ cấu 4-thanh) bị bỏ: chúng cần mimic để chuyển
       động, mà Gazebo không hỗ trợ; giữ lại thì đứng yên và chồng lên vùng ngón đóng.
       Giữ mỗi bên 2 link: proximal (left3/right3, được điều khiển) + tip (left1/right1). -->
  <xacro:finger_link name="gripper_left1"  mesh_file="gripper_left1.dae"  ox="0.039"  oy="-0.0133" oz="-0.012"/>
  <xacro:finger_link name="gripper_left3"  mesh_file="gripper_left3.dae"  ox="0.012"  oy="0.0025"  oz="-0.012"/>
  <xacro:finger_link name="gripper_right1" mesh_file="gripper_right1.dae" ox="-0.039" oy="-0.0133" oz="-0.012"/>
  <xacro:finger_link name="gripper_right3" mesh_file="gripper_right3.dae" ox="-0.012" oy="0.0025"  oz="-0.012"/>

  <!-- ===== 2 khớp ngón được điều khiển (đối xứng) ===== -->
  <joint name="gripper_finger_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${geff}" lower="-0.74" upper="0.15" velocity="${gvel}"/>
    <parent link="gripper_base"/>
    <child link="gripper_left3"/>
    <origin xyz="-0.012 0.005 0" rpy="0 0 0"/>
  </joint>

  <joint name="gripper_right_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="${geff}" lower="-0.15" upper="0.74" velocity="${gvel}"/>
    <parent link="gripper_base"/>
    <child link="gripper_right3"/>
    <origin xyz="0.012 0.005 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== 4 khớp linkage: HÀN CỐ ĐỊNH ===== -->
  <joint name="gripper_left3_to_gripper_left1" type="fixed">
    <parent link="gripper_left3"/>
    <child link="gripper_left1"/>
    <origin xyz="-0.027 0.016 0" rpy="0 0 0"/>
  </joint>
  <joint name="gripper_right3_to_gripper_right1" type="fixed">
    <parent link="gripper_right3"/>
    <child link="gripper_right1"/>
    <origin xyz="0.027 0.016 0" rpy="0 0 0"/>
  </joint>

  <!-- Điểm gắp: giữa 2 ngón. Offset tạm, tinh chỉnh Phase 6/7. -->
  <link name="grasp_center"/>
  <joint name="gripper_base_to_grasp_center" type="fixed">
    <parent link="gripper_base"/>
    <child link="grasp_center"/>
    <origin xyz="0 0.05 -0.012" rpy="0 0 0"/>
  </joint>
</robot>
