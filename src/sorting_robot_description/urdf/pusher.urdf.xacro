<?xml version="1.0"?>
<!-- Servo pusher: a post fixed beside the end of the belt with a single
     prismatic joint. The paddle rests clear of the belt (+Y side) and, when
     commanded, slides across the belt toward -Y to shove a rejected cube off
     the edge. Controlled through ros2_control / gz_ros2_control. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="pusher">

  <!-- Path to the controller manager YAML, injected by the launch file. -->
  <xacro:arg name="controllers_config" default=""/>

  <!-- Pose of the pusher base in the world (beside the belt end). -->
  <xacro:property name="base_x" value="0.6"/>
  <xacro:property name="base_y" value="0.35"/>
  <xacro:property name="base_z" value="0.615"/>

  <!-- Prismatic stroke (m): 0 = retracted (clear of belt), negative = across. -->
  <xacro:property name="stroke" value="0.70"/>

  <material name="pusher_orange">
    <color rgba="0.9 0.45 0.1 1"/>
  </material>
  <material name="pusher_grey">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>

  <!-- Reserved world link: a fixed joint to it anchors the base in Gazebo. -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="${base_x} ${base_y} ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- Static mounting post: reaches from the mount height down to the floor. -->
  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.29" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.58"/></geometry>
      <material name="pusher_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.29" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.58"/></geometry>
    </collision>
  </link>

  <!-- Prismatic joint sliding along Y. Retracted at 0, extends toward -Y. -->
  <joint name="pusher_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="pusher_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- High effort + speed so the belt-driven cube's resistance is negligible
         and the stroke always completes within the fixed extend_time, keeping
         the push timing deterministic for the cubes queued behind. Low
         damping/friction so the joint is not sluggish. -->
    <limit lower="-${stroke}" upper="0.0" effort="300.0" velocity="3.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <!-- Paddle that contacts the cube. -->
  <link name="pusher_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00027" ixy="0" ixz="0"
               iyy="0.00081" iyz="0" izz="0.00059"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.15 0.03 0.10"/></geometry>
      <material name="pusher_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.15 0.03 0.10"/></geometry>
      <surface>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </surface>
    </collision>
  </link>

  <!-- ros2_control hardware: expose position command + position/velocity state. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="pusher_joint">
      <command_interface name="position">
        <param name="min">-${stroke}</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- gz_ros2_control system plugin: starts a controller_manager inside Gazebo. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_config)</parameters>
    </plugin>
  </gazebo>

</robot>
