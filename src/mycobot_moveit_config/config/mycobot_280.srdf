<?xml version="1.0" encoding="UTF-8"?>
<!--
  SRDF cho myCobot 280 (viết tay thay cho MoveIt Setup Assistant vì môi trường headless).
  - Group "arm": chuỗi động học từ g_base -> grasp_center (điểm gắp giữa 2 ngón).
  - Group "gripper": 2 khớp ngón đối xứng (gripper_controller điều khiển cả hai).
  - Base cố định vào link `world` đã khai báo trong URDF -> KHÔNG cần virtual_joint.
  Chiều đóng/mở gripper (theo limit trong URDF):
    gripper_finger_joint: mở=+0.15  đóng=-0.74
    gripper_right_joint : mở=-0.15  đóng=+0.74   (đối xứng)
-->
<robot name="mycobot_280">
  <!-- ===================== GROUPS ===================== -->
  <group name="arm">
    <chain base_link="g_base" tip_link="grasp_center"/>
  </group>

  <group name="gripper">
    <joint name="gripper_finger_joint"/>
    <joint name="gripper_right_joint"/>
  </group>

  <!-- ===================== GROUP STATES ===================== -->
  <group_state name="home" group="arm">
    <joint name="joint2_to_joint1" value="0"/>
    <joint name="joint3_to_joint2" value="0"/>
    <joint name="joint4_to_joint3" value="0"/>
    <joint name="joint5_to_joint4" value="0"/>
    <joint name="joint6_to_joint5" value="0"/>
    <joint name="joint6output_to_joint6" value="0"/>
  </group_state>

  <!-- Tư thế "ready": khuỷu gập, đầu gắp hướng xuống trước mặt (thuận cho pick). -->
  <group_state name="ready" group="arm">
    <joint name="joint2_to_joint1" value="0"/>
    <joint name="joint3_to_joint2" value="-0.5"/>
    <joint name="joint4_to_joint3" value="-1.2"/>
    <joint name="joint5_to_joint4" value="-1.4"/>
    <joint name="joint6_to_joint5" value="1.57"/>
    <joint name="joint6output_to_joint6" value="0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="gripper_finger_joint" value="0.15"/>
    <joint name="gripper_right_joint" value="-0.15"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="gripper_finger_joint" value="-0.74"/>
    <joint name="gripper_right_joint" value="0.74"/>
  </group_state>

  <!-- ===================== END EFFECTOR ===================== -->
  <end_effector name="gripper_ee" parent_link="grasp_center" group="gripper" parent_group="arm"/>

  <!-- ===================== DISABLE COLLISIONS ===================== -->
  <disable_collisions link1="world" link2="g_base" reason="Adjacent"/>
  <disable_collisions link1="g_base" link2="joint1" reason="Adjacent"/>
  <disable_collisions link1="joint1" link2="joint2" reason="Adjacent"/>
  <disable_collisions link1="joint2" link2="joint3" reason="Adjacent"/>
  <disable_collisions link1="joint3" link2="joint4" reason="Adjacent"/>
  <disable_collisions link1="joint4" link2="joint5" reason="Adjacent"/>
  <disable_collisions link1="joint5" link2="joint6" reason="Adjacent"/>
  <disable_collisions link1="joint6" link2="joint6_flange" reason="Adjacent"/>
  <disable_collisions link1="joint6_flange" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_left3" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_right3" reason="Adjacent"/>
  <disable_collisions link1="gripper_left3" link2="gripper_left1" reason="Adjacent"/>
  <disable_collisions link1="gripper_right3" link2="gripper_right1" reason="Adjacent"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right3" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="gripper_right1" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="gripper_left1" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="gripper_right1" reason="Never"/>
  <!-- Cặp gần kề có thể chạm khi gập khuỷu -->
  <disable_collisions link1="joint1" link2="joint3" reason="Never"/>
  <disable_collisions link1="joint4" link2="joint6" reason="Never"/>
  <disable_collisions link1="joint5" link2="joint6_flange" reason="Never"/>
  <disable_collisions link1="joint6" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="joint6_flange" link2="gripper_left3" reason="Never"/>
  <disable_collisions link1="joint6_flange" link2="gripper_right3" reason="Never"/>
</robot>
